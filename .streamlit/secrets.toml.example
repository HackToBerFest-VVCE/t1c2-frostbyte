# .streamlit/secrets.toml.example
# Copy this file to .streamlit/secrets.toml and fill in your real Snowflake credentials.
# IMPORTANT: Never commit .streamlit/secrets.toml to version control.

[snowflake]
# Snowflake Account Identifier
# Format: <orgname>-<account_name> or <account_locator>.<region> (e.g. "xy12345.us-east-1" or "myorg-myaccount")
account = "YOUR_ACCOUNT_IDENTIFIER"

# Snowflake Login Credentials
# Note: Use your Snowflake LOGIN_NAME (which may be your username or email address)
user = "YOUR_SNOWFLAKE_USERNAME"
password = "YOUR_SNOWFLAKE_PASSWORD"

# Snowflake Compute Warehouse
warehouse = "COMPUTE_WH"

# Target Database and Schema (TPC-DS Sample Data)
database = "SNOWFLAKE_SAMPLE_DATA"
schema = "TPCDS_SF10TCL"

# Optional Role (e.g., ACCOUNTADMIN, SYSADMIN, or PUBLIC)
role = "ACCOUNTADMIN"

# Optional Authenticator
# Set to "externalbrowser" if your Snowflake account uses Google Sign-In, SSO, or has MFA enforced:
# authenticator = "externalbrowser"
