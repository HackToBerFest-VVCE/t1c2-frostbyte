# DataLens Configuration Template
# Duplicate this file as 'secrets.toml' inside '.streamlit/' to connect to live Snowflake.

[snowflake]
account = "your_snowflake_account_id"
user = "your_username"
password = "your_password"
warehouse = "COMPUTE_WH"
database = "SNOWFLAKE_SAMPLE_DATA"
schema = "TPCDS_SF10TCL"
role = "ACCOUNTADMIN"

[qwen]
# Inference endpoint for Qwen3-4B
# Options:
# 1. Local Ollama: "http://localhost:11434/api/generate"
# 2. Local vLLM / OpenAI-compatible API: "http://localhost:8000/v1/chat/completions"
# 3. Hosted Hugging Face / Cloud Inference API
endpoint_url = "http://localhost:11434/api/generate"
api_key = ""
model_name = "qwen3:4b"
temperature = 0.1
